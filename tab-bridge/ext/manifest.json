{
  "manifest_version": 3,
  "name": "Tab Bridge",
  "version": "1.3",
  "minimum_chrome_version": "116",
  "description": "Local control bridge for AI agents - drives tabs via chrome.debugger CDP relay to 127.0.0.1:8765",
  "permissions": ["debugger", "tabs", "alarms", "downloads", "system.display", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "bg.js" }
}
